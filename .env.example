# Copy this file to .env and choose your own values.

# --- Database ---
# Docker uses these to create the Postgres database the first time it starts,
# and the app uses them to connect to it.
PG_USER=searchuser
PG_PASSWORD=change-me
PG_DB=searchdb

# --- Answer model ---
# Which size of the Qwen 2.5 model writes the answers: 3b or 7b.
# Restart the app after changing it.
#
# 3b (default): recommended for most computers, including 16 GB laptops.
#   + Uses about 2.6 GB of memory
#   + Faster answers (the model part takes about 2-6 seconds)
#   + 2.1 GB download
#   - Sometimes misreads relationships in its sources,
#     e.g. mixing up a character's grandfather and father
#
# 7b: more accurate, but needs a more powerful computer.
#   + Better at reading comprehension: relationships, who "he" or "her" refers to,
#     and questions that need several facts combined
#   - Uses about 5.5 GB of memory, so 32 GB of RAM is recommended. On a 16 GB computer
#     it leaves little room for other apps, and the system may slow down sharply
#   - Slower answers: the model part takes roughly twice as long
#   - Extra 4.7 GB download the first time you use it, and that much more disk space
#   - Still a small model: it makes fewer mistakes, not none, so check important facts
LLM_SIZE=3b
